         public IBuildEngine BuildEngine { get; set; } = null!;
         public ITaskHost HostObject { get; set; } = null!;
+
+        private void InjectLegacyShims(string assemblyPath)
+        {
+            try
+            {
+                if (!File.Exists(assemblyPath))
+                    return;
+
+                var resolver = new DefaultAssemblyResolver();
+                var dir = Path.GetDirectoryName(assemblyPath);
+                if (!string.IsNullOrEmpty(dir))
+                    resolver.AddSearchDirectory(dir);
+
+                if (File.Exists(ReferencesFilePath))
+                {
+                    foreach (var r in File.ReadAllLines(ReferencesFilePath))
+                    {
+                        if (!string.IsNullOrWhiteSpace(r))
+                        {
+                            var refDir = Path.GetDirectoryName(r);
+                            if (!string.IsNullOrEmpty(refDir))
+                                resolver.AddSearchDirectory(refDir);
+                        }
+                    }
+                }
+
+                var readerParams = new ReaderParameters { ReadWrite = true, AssemblyResolver = resolver };
+                using var asm = AssemblyDefinition.ReadAssembly(assemblyPath, readerParams);
+
+                var modified = false;
+
+                // Shim Control.get_StyleClasses returning ICollection<string>
+                var controlType = asm.MainModule.GetType("Robust.Client.UserInterface.Control");
+                if (controlType != null)
+                {
+                    var modernGetter = controlType.Methods.FirstOrDefault(m => m.Name == "get_StyleClasses" && m.Parameters.Count == 0 && m.ReturnType.Name != "ICollection`1");
+                    if (modernGetter != null && !controlType.Methods.Any(m => m.Name == "get_StyleClasses" && m.ReturnType.Name == "ICollection`1"))
+                    {
+                        var iCollectionType = asm.MainModule.ImportReference(typeof(ICollection<string>));
+                        var legacyGetter = new MethodDefinition("get_StyleClasses",
+                            MethodAttributes.Public | MethodAttributes.HideBySig | MethodAttributes.SpecialName,
+                            iCollectionType);
+
+                        var il = legacyGetter.Body.GetILProcessor();
+                        il.Emit(OpCodes.Ldarg_0);
+                        il.Emit(OpCodes.Call, modernGetter);
+                        il.Emit(OpCodes.Ret);
+
+                        controlType.Methods.Add(legacyGetter);
+                        modified = true;
+                        BuildEngine.LogMessage("Injected legacy ICollection<string> get_StyleClasses shim into Control", MessageImportance.High);
+                    }
+                }
+
+                // Shim Button.get_StyleClasses returning ICollection<string>
+                var buttonType = asm.MainModule.GetType("Robust.Client.UserInterface.Controls.Button");
+                if (buttonType != null)
+                {
+                    var modernGetter = buttonType.Methods.FirstOrDefault(m => m.Name == "get_StyleClasses" && m.Parameters.Count == 0 && m.ReturnType.Name != "ICollection`1");
+                    if (modernGetter != null && !buttonType.Methods.Any(m => m.Name == "get_StyleClasses" && m.ReturnType.Name == "ICollection`1"))
+                    {
+                        var iCollectionType = asm.MainModule.ImportReference(typeof(ICollection<string>));
+                        var legacyGetter = new MethodDefinition("get_StyleClasses",
+                            MethodAttributes.Public | MethodAttributes.HideBySig | MethodAttributes.SpecialName,
+                            iCollectionType);
+
+                        var il = legacyGetter.Body.GetILProcessor();
+                        il.Emit(OpCodes.Ldarg_0);
+                        il.Emit(OpCodes.Call, modernGetter);
+                        il.Emit(OpCodes.Ret);
+
+                        buttonType.Methods.Add(legacyGetter);
+                        modified = true;
+                        BuildEngine.LogMessage("Injected legacy ICollection<string> get_StyleClasses shim into Button", MessageImportance.High);
+                    }
+                }
+
+                if (modified)
+                {
+                    asm.Write();
+                }
+            }
+            catch (Exception ex)
+            {
+                BuildEngine.LogMessage($"Warning: Failed to inject legacy shims into {assemblyPath}: {ex.Message}", MessageImportance.Normal);
+            }
+        }
     }
 }
