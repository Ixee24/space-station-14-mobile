+using System;
+using System.Collections.Generic;
+using System.Diagnostics.CodeAnalysis;
+using Robust.Shared.GameObjects;
+using Robust.Shared.IoC;
+using Robust.Shared.Map.Components;
+using Robust.Shared.Maths;
+using Robust.Shared.Physics;
+using Robust.Shared.Physics.Collision.Shapes;
+
+namespace Robust.Shared.Map
+{
+    public delegate bool GridCallback(EntityUid gridUid, MapGridComponent gridComp);
+    public delegate bool GridCallback<TState>(EntityUid gridUid, MapGridComponent gridComp, ref TState state);
+
+    public record struct GridCreateOptions(ushort ChunkSize)
+    {
+        public static readonly GridCreateOptions Default = new(16);
+    }
+
+    public interface IMapManager
+    {
+        Entity<MapGridComponent> CreateGridEntity(MapId mapId, GridCreateOptions? options = null);
+        Entity<MapGridComponent> CreateGridEntity(EntityUid map, GridCreateOptions? options = null);
+
+        bool TryFindGridAt(MapId mapId, System.Numerics.Vector2 worldPos, out EntityUid uid, [NotNullWhen(true)] out MapGridComponent? grid);
+        bool TryFindGridAt(EntityUid mapEnt, System.Numerics.Vector2 worldPos, out EntityUid uid, [NotNullWhen(true)] out MapGridComponent? grid);
+        bool TryFindGridAt(MapCoordinates mapCoordinates, out EntityUid uid, [NotNullWhen(true)] out MapGridComponent? grid);
+
+        void FindGridsIntersecting<T>(MapId mapId, T shape, Transform transform, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true) where T : IPhysShape;
+        void FindGridsIntersecting(MapId mapId, Box2 worldAABB, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true);
+        void FindGridsIntersecting(MapId mapId, Box2Rotated worldBounds, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true);
+        void FindGridsIntersecting<TState>(MapId mapId, Box2 worldAABB, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true);
+        void FindGridsIntersecting<TState>(MapId mapId, Box2Rotated worldBounds, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true);
+
+        void FindGridsIntersecting<T>(EntityUid mapEnt, T shape, Transform transform, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true) where T : IPhysShape;
+        void FindGridsIntersecting(EntityUid mapEnt, Box2 worldAABB, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true);
+        void FindGridsIntersecting(EntityUid mapEnt, Box2Rotated worldBounds, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true);
+        void FindGridsIntersecting<TState>(EntityUid mapEnt, Box2 worldAABB, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true);
+        void FindGridsIntersecting<TState>(EntityUid mapEnt, Box2Rotated worldBounds, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true);
+
+        bool MapExists(MapId mapId);
+        IEnumerable<MapGridComponent> GetAllGrids();
+        IEnumerable<MapGridComponent> FindGridsIntersecting(MapId mapId, Box2Rotated worldBounds, bool approx = false, bool includeMap = true);
+        IEnumerable<MapGridComponent> FindGridsIntersecting(MapId mapId, Box2 worldAABB, bool approx = false, bool includeMap = true);
+    }
+
+    public sealed class MapManager : IMapManager
+    {
+        [Dependency] private readonly IEntityManager _entManager = default!;
+        private SharedMapSystem MapSystem => _entManager.System<SharedMapSystem>();
+
+        public bool MapExists(MapId mapId) => MapSystem.MapExists(mapId);
+        public IEnumerable<MapGridComponent> GetAllGrids()
+        {
+            var query = _entManager.EntityQueryEnumerator<MapGridComponent>();
+            while (query.MoveNext(out _, out var grid))
+            {
+                yield return grid;
+            }
+        }
+        public IEnumerable<MapGridComponent> FindGridsIntersecting(MapId mapId, Box2Rotated worldBounds, bool approx = false, bool includeMap = true)
+        {
+            var list = new List<Entity<MapGridComponent>>();
+            FindGridsIntersecting(mapId, worldBounds, ref list, approx, includeMap);
+            foreach (var g in list) yield return g.Comp;
+        }
+        public IEnumerable<MapGridComponent> FindGridsIntersecting(MapId mapId, Box2 worldAABB, bool approx = false, bool includeMap = true)
+        {
+            var list = new List<Entity<MapGridComponent>>();
+            FindGridsIntersecting(mapId, worldAABB, ref list, approx, includeMap);
+            foreach (var g in list) yield return g.Comp;
+        }
+
+        public Entity<MapGridComponent> CreateGridEntity(MapId mapId, GridCreateOptions? options = null)
+            => MapSystem.CreateGridEntity(mapId, options != null ? new Robust.Shared.GameObjects.GridCreateOptions(options.Value.ChunkSize) : null);
+
+        public Entity<MapGridComponent> CreateGridEntity(EntityUid map, GridCreateOptions? options = null)
+            => MapSystem.CreateGridEntity(map, options != null ? new Robust.Shared.GameObjects.GridCreateOptions(options.Value.ChunkSize) : null);
+
+        public bool TryFindGridAt(MapId mapId, System.Numerics.Vector2 worldPos, out EntityUid uid, [NotNullWhen(true)] out MapGridComponent? grid)
+            => MapSystem.TryFindGridAt(mapId, worldPos, out uid, out grid);
+
+        public bool TryFindGridAt(EntityUid mapEnt, System.Numerics.Vector2 worldPos, out EntityUid uid, [NotNullWhen(true)] out MapGridComponent? grid)
+            => MapSystem.TryFindGridAt(mapEnt, worldPos, out uid, out grid);
+
+        public bool TryFindGridAt(MapCoordinates mapCoordinates, out EntityUid uid, [NotNullWhen(true)] out MapGridComponent? grid)
+            => MapSystem.TryFindGridAt(mapCoordinates, out uid, out grid);
+
+        public void FindGridsIntersecting<T>(MapId mapId, T shape, Transform transform, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true) where T : IPhysShape
+            => MapSystem.FindGridsIntersecting(mapId, shape, transform, ref grids, approx, includeMap);
+
+        public void FindGridsIntersecting(MapId mapId, Box2 worldAABB, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true)
+            => MapSystem.FindGridsIntersecting(mapId, worldAABB, ref grids, approx, includeMap);
+
+        public void FindGridsIntersecting(MapId mapId, Box2Rotated worldBounds, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true)
+            => MapSystem.FindGridsIntersecting(mapId, worldBounds, ref grids, approx, includeMap);
+
+        public void FindGridsIntersecting<TState>(MapId mapId, Box2 worldAABB, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true)
+        {
+            var cb = callback;
+            MapSystem.FindGridsIntersecting(mapId, worldAABB, ref state, (EntityUid u, MapGridComponent g, ref TState s) => cb(u, g, ref s), approx, includeMap);
+        }
+
+        public void FindGridsIntersecting<TState>(MapId mapId, Box2Rotated worldBounds, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true)
+        {
+            var cb = callback;
+            MapSystem.FindGridsIntersecting(mapId, worldBounds, ref state, (EntityUid u, MapGridComponent g, ref TState s) => cb(u, g, ref s), approx, includeMap);
+        }
+
+        public void FindGridsIntersecting<T>(EntityUid mapEnt, T shape, Transform transform, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true) where T : IPhysShape
+            => MapSystem.FindGridsIntersecting(mapEnt, shape, transform, ref grids, approx, includeMap);
+
+        public void FindGridsIntersecting(EntityUid mapEnt, Box2 worldAABB, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true)
+            => MapSystem.FindGridsIntersecting(mapEnt, worldAABB, ref grids, approx, includeMap);
+
+        public void FindGridsIntersecting(EntityUid mapEnt, Box2Rotated worldBounds, ref List<Entity<MapGridComponent>> grids, bool approx = false, bool includeMap = true)
+            => MapSystem.FindGridsIntersecting(mapEnt, worldBounds, ref grids, approx, includeMap);
+
+        public void FindGridsIntersecting<TState>(EntityUid mapEnt, Box2 worldAABB, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true)
+        {
+            var cb = callback;
+            MapSystem.FindGridsIntersecting(mapEnt, worldAABB, ref state, (EntityUid u, MapGridComponent g, ref TState s) => cb(u, g, ref s), approx, includeMap);
+        }
+
+        public void FindGridsIntersecting<TState>(EntityUid mapEnt, Box2Rotated worldBounds, ref TState state, GridCallback<TState> callback, bool approx = false, bool includeMap = true)
+        {
+            var cb = callback;
+            MapSystem.FindGridsIntersecting(mapEnt, worldBounds, ref state, (EntityUid u, MapGridComponent g, ref TState s) => cb(u, g, ref s), approx, includeMap);
+        }
+    }
+}
